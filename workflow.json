    {
      "parameters": {
        "jsCode": "// 1. Pega o texto bruto\nlet raw = $input.first().json.content.parts[0].text;\n\n// contador de retry\nlet retry = $json.retry || 0;\n\n// 2. Validação básica\nif (!raw) {\n  return [{\n    json: {\n      success: false,\n      retry,\n      error: \"Resposta da IA veio vazia\"\n    }\n  }];\n}\n\n// 3. Remove markdown\nraw = raw\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// 4. Extrai apenas o JSON (entre { })\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\n\nif (!match) {\n  return [{\n    json: {\n      success: false,\n      retry,\n      error: \"Não encontrou JSON válido\",\n      raw_output: raw\n    }\n  }];\n}\n\nraw = match[0];\n\n// 5. Corrige problemas comuns\nraw = raw\n  .replace(/,\\s*([}\\]])/g, \"$1\") // vírgula inválida\n  .replace(/'/g, '\"') // aspas simples\n  .replace(/\\n/g, \" \"); // quebra de linha\n\n// 6. Parse\nlet data;\ntry {\n  data = JSON.parse(raw);\n} catch (e) {\n  return [{\n    json: {\n      success: false,\n      retry,\n      error: \"JSON inválido após limpeza\",\n      raw_output: raw\n    }\n  }];\n}\n\n// 7. Segurança\nconst passos = Array.isArray(data.passos_sugeridos) ? data.passos_sugeridos : [];\nconst tags = Array.isArray(data.tags) ? data.tags : [];\n\n// 8. Formatação dos passos\nconst passos_texto = passos\n  .map(p => {\n    if (typeof p === \"string\") return `- ${p}`;\n    return `- [${(p.prioridade || \"media\").toUpperCase()}] ${p.descricao || \"\"}`;\n  })\n  .join(\"\\n\");\n\n// 9. SUCESSO\nreturn [\n  {\n    json: {\n      success: true,\n      retry,\n      resumo: data.resumo || \"\",\n      tipo: data.tipo || \"\",\n      prioridade: data.prioridade || \"\",\n      contexto: data.contexto || \"\",\n      passos,\n      passos_texto,\n      tags,\n      tags_texto: tags.join(\", \")\n    }\n  }\n];"
      },
