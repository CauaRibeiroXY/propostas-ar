    {
      "parameters": {
        "sendHTML": true,
        "subject": "Seus pensamentos foram organizados com sucesso 🚀",
        "htmlContent": "=<div style=\"background-color: #f8fafc; padding: 40px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\">\n  <div style=\"max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);\">\n\n    <div style=\"background-color: #1e293b; padding: 24px 32px;\">\n      <h2 style=\"color: #ffffff; margin: 0; font-size: 20px; font-weight: 600;\">Relatório da Solicitação</h2>\n    </div>\n\n    <div style=\"padding: 32px;\">\n      \n      <table style=\"width: 100%; border-collapse: collapse; font-size: 15px; color: #334155; margin-bottom: 40px;\">\n        <tr>\n          <td style=\"padding: 14px 0; border-bottom: 1px solid #f1f5f9; font-weight: 600; width: 130px; color: #0f172a;\">Resumo</td>\n          <td style=\"padding: 14px 0; border-bottom: 1px solid #f1f5f9;\">{{$json.resumo}}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 14px 0; border-bottom: 1px solid #f1f5f9; font-weight: 600; color: #0f172a;\">Tipo</td>\n          <td style=\"padding: 14px 0; border-bottom: 1px solid #f1f5f9;\">{{$json.tipo}}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 14px 0; border-bottom: 1px solid #f1f5f9; font-weight: 600; color: #0f172a;\">Prioridade</td>\n          <td style=\"padding: 14px 0; border-bottom: 1px solid #f1f5f9;\">\n            {{\n              $json.prioridade === 'alta'\n                ? '<span style=\"color:#b91c1c; background-color:#fee2e2; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; border: 1px solid #fca5a5;\">Alta</span>'\n                : $json.prioridade === 'media'\n                ? '<span style=\"color:#b45309; background-color:#fef3c7; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; border: 1px solid #fcd34d;\">Média</span>'\n                : '<span style=\"color:#15803d; background-color:#dcfce7; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; border: 1px solid #86efac;\">Baixa</span>'\n            }}\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding: 14px 0; border-bottom: 1px solid #f1f5f9; font-weight: 600; color: #0f172a;\">Contexto</td>\n          <td style=\"padding: 14px 0; border-bottom: 1px solid #f1f5f9; line-height: 1.5;\">{{$json.contexto}}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 14px 0; font-weight: 600; color: #0f172a;\">Tags</td>\n          <td style=\"padding: 14px 0;\">{{$json.tags_texto}}</td>\n        </tr>\n      </table>\n\n      <h3 style=\"color: #0f172a; margin-top: 0; margin-bottom: 20px; font-size: 18px; font-weight: 600;\">Passos Sugeridos</h3>\n\n      <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\">\n        <thead>\n          <tr style=\"background-color: #f8fafc;\">\n            <th style=\"padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; border-bottom: 2px solid #e2e8f0; width: 120px;\">Prioridade</th>\n            <th style=\"padding: 14px 16px; text-align: left; font-weight: 600; color: #475569; border-bottom: 2px solid #e2e8f0;\">Ação</th>\n          </tr>\n        </thead>\n        <tbody>\n          {{\n            $json.passos.map(p => {\n              let badge = '<span style=\"color:#15803d; background-color:#dcfce7; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; border: 1px solid #86efac;\">Baixa</span>';\n\n              if (p.prioridade === 'alta') {\n                badge = '<span style=\"color:#b91c1c; background-color:#fee2e2; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; border: 1px solid #fca5a5;\">Alta</span>';\n              } else if (p.prioridade === 'media') {\n                badge = '<span style=\"color:#b45309; background-color:#fef3c7; padding:4px 12px; border-radius:12px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; border: 1px solid #fcd34d;\">Média</span>';\n              }\n\n              return `\n                <tr>\n                  <td style=\"padding: 16px; border-bottom: 1px solid #f1f5f9; vertical-align: top;\">${badge}</td>\n                  <td style=\"padding: 16px; border-bottom: 1px solid #f1f5f9; color: #334155; line-height: 1.6; vertical-align: top;\">${p.descricao}</td>\n                </tr>\n              `;\n            }).join('')\n          }}\n        </tbody>\n      </table>\n\n    </div>\n\n    <div style=\"background-color: #f8fafc; padding: 20px 32px; border-top: 1px solid #e2e8f0; text-align: center;\">\n      <p style=\"margin: 0; font-size: 13px; color: #64748b; line-height: 1.5;\">\n        Este é um documento processado pelo sistema.<br>\n        Não é necessário responder a esta mensagem.\n      </p>\n    </div>\n\n  </div>\n</div>",
        "sender": "cauaribeiropsn@gmail.com",
